# cp .env.example .env  и поменять секреты. Файл .env в git не попадает.
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-db
POSTGRES_DB=app

# S3: для demo-стенда это SeaweedFS из docker-compose.yml.
# В проде: свой endpoint (или пусто для AWS), ключи ограниченного пользователя.
S3_ENDPOINT=http://127.0.0.1:8333
S3_ACCESS_KEY=backup-access-key
S3_SECRET_KEY=change-me-s3-secret
S3_REGION=us-east-1
S3_BUCKET=pg-backups
S3_PREFIX=postgres/

RETENTION_DAYS=30
# таблицы, по которым restore.sh сверяет количество строк
VERIFY_TABLES="customers orders order_items"
# restore.sh: сколько строк (в долях от manifest) минимум должно быть после восстановления
RESTORE_MIN_RATIO=0.95
